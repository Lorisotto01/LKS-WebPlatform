# Credenziali pubbliche Supabase — sicure da spedire al browser.
# Usa la "publishable key" (sb_publishable_...) dei progetti recenti,
# oppure la vecchia "anon key" sui progetti legacy. Sono equivalenti.
# La chiave secret/service_role NON va mai qui (solo nel Tool CLI).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# In alternativa (legacy):
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL per i link di verifica email. In sviluppo metti l'IP LAN della macchina
# (es. http://192.168.1.50:5173) cosi il link funziona anche aprendolo dal telefono.
# In produzione: il dominio Netlify. Vuoto = usa l'origine corrente del browser.
# Ricorda di aggiungerlo agli allowed Redirect URLs in Supabase.
VITE_PUBLIC_SITE_URL=http://192.168.1.XX:5173

# ============================================================================
# Secret delle Supabase Edge Functions — Checkout & Pagamenti (v4.4.0)
#
# NON committare il file .env reale. Imposta i secret con:
#   supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY sono iniettate
# automaticamente da Supabase nelle Edge Functions: NON serve impostarle qui
# (elencate solo come riferimento).
# ============================================================================

# --- Iniettate automaticamente da Supabase (solo riferimento) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Dominio pubblico del sito (per success_url/cancel_url del checkout) ---
# ATTENZIONE: questa variabile serve alle Edge Function, non al build del sito, e
# NON viene caricata da `npm run functions:secrets` (che legge solo
# supabase/functions/.env). Va impostata fra i secret del progetto Supabase:
#   supabase secrets set PUBLIC_SITE_URL=https://securelocalshare.netlify.app
# Da v4.8.2 decide anche l'origine ammessa dal CORS delle function.
PUBLIC_SITE_URL=https://securelocalshare.netlify.app

# --- Origini extra ammesse dal CORS delle Edge Function (opzionale) ---
# Elenco separato da virgole, oltre a PUBLIC_SITE_URL. Servono solo se chiami le
# function da un dominio diverso da quello di produzione: un dominio custom, uno
# staging, un altro frontend.
# Sono gia' ammessi d'ufficio, senza elencarli qui:
#   - i deploy preview e i branch deploy dello stesso sito Netlify
#     (https://<qualsiasi-cosa>--<sito>.netlify.app);
#   - localhost, 127.0.0.1 e gli indirizzi di rete privata (10.x, 172.16-31.x,
#     192.168.x) su qualsiasi porta, per lo sviluppo.
# Anche questa, se usata, va impostata fra i secret Supabase, non qui.
# ALLOWED_ORIGINS=https://www.miodominio.it,https://staging.miodominio.it

# --- Stripe (opzionale: se assente → modalità simulata) ---
# Dashboard Stripe → Developers → API keys (usa le chiavi TEST per iniziare)
STRIPE_SECRET_KEY=<la-tua-stripe-secret-key>
# Dashboard Stripe → Developers → Webhooks → (endpoint) → Signing secret
STRIPE_WEBHOOK_SECRET=<il-tuo-stripe-webhook-signing-secret>

# --- PayPal (opzionale: se assente → modalità simulata) ---
# Developer Dashboard PayPal → Apps & Credentials → (app) → Client ID / Secret
PAYPAL_CLIENT_ID=<il-tuo-paypal-client-id>
PAYPAL_SECRET=<il-tuo-paypal-secret>
# Sandbox: https://api-m.sandbox.paypal.com   ·   Produzione: https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# OBBLIGATORIO da v4.8.2 (rilievo C2): senza questo id il paypal-webhook rifiuta
# ogni evento, perche non puo verificarne la firma presso PayPal.
# Dashboard PayPal -> Apps & Credentials -> (app) -> Webhooks -> Webhook ID
PAYPAL_WEBHOOK_ID=<il-tuo-paypal-webhook-id>

# --- Email (Resend) per l'invio del file di sblocco unlock.lks ---
# Crea un account su resend.com → API Keys. Senza chiave, l'admin ottiene comunque
# il link firmato da inoltrare a mano; l'utente può scaricare dalla sua dashboard.
RESEND_API_KEY=<la-tua-resend-api-key>
RESEND_FROM=SecureLocalShare <no-reply@tuo-dominio>
